# Copy to .env and fill in. Every new variable must be added here (convention §14).
# Variables marked [Mn] are consumed from that milestone onwards and are ignored today.

# ---------------------------------------------------------------- runtime
NODE_ENV=development
LOG_LEVEL=debug

# Public address the app is served on. Behind Cloudflare Tunnel this is your domain,
# e.g. https://treino.seudominio.com.br
PUBLIC_APP_URL=http://localhost:8080

# Origins allowed to call the API with credentials. In production the SPA and the API
# share one origin (nginx), so this only matters for the Vite dev server.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Host port the `web` container publishes on loopback — the one cloudflared points at.
WEB_PORT=8080

# ---------------------------------------------------------------- api
PORT=3000
API_PREFIX=api/v1

# ---------------------------------------------------------------- postgres
POSTGRES_USER=personal
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=personal
POSTGRES_PORT=5432

# Used when the API runs on the host (pnpm dev). Inside compose the API gets this value
# built from POSTGRES_* with host `postgres`.
DATABASE_URL=postgresql://personal:change-me-postgres@localhost:5432/personal?schema=public

# ---------------------------------------------------------------- redis
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------- storage (MinIO / S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_CONSOLE_URL=http://localhost:9001

S3_BUCKET=personal-media
S3_REGION=us-east-1
# Endpoint the API uses internally.
S3_ENDPOINT=http://localhost:9000
# Endpoint presigned URLs are signed for — must be reachable by the browser. In
# production, a second cloudflared route such as https://media.seudominio.com.br
S3_PUBLIC_ENDPOINT=http://localhost:9000
# Same credentials as MINIO_ROOT_USER/PASSWORD above — MinIO's S3-compatible API uses
# its root user as the access key.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-minio
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------- migrations & seed
RUN_MIGRATIONS=true
RUN_SEED=false
SEED_TENANT_SLUG=demo
SEED_TENANT_NAME=Academia Demo
SEED_TRAINER_EMAIL=trainer@demo.local
SEED_ADMIN_EMAIL=admin@demo.local
# Required when NODE_ENV=production; in development all three default to `changeme123`.
SEED_TRAINER_PASSWORD=
SEED_STUDENT_PASSWORD=
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------- auth [M1]
# openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Cookie domain for the refresh token; leave empty for host-only cookies.
COOKIE_DOMAIN=

# ---------------------------------------------------------------- encryption at rest [M6]
# 32-byte key, base64. Encrypts the anamnesis fields (LGPD §10.3).
# openssl rand -base64 32
HEALTH_DATA_ENCRYPTION_KEY=

# ---------------------------------------------------------------- web push [M8]
# npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:voce@seudominio.com.br
