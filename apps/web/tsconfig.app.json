{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "vite-plugin-pwa/client", "jest", "@testing-library/jest-dom"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    // Kept in sync with `resolve.alias` in vite.config.ts and `moduleNameMapper` in
    // jest.config.cjs — all three must agree.
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"]
}
