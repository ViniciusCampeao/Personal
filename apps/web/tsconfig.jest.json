{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "composite": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "allowImportingTsExtensions": false,
    "isolatedModules": false,
    // WebWorker is dropped (the app config needs it for src/sw.ts, tests never run it).
    // With both DOM and WebWorker in scope the global `navigator` resolves to
    // WorkerNavigator, and every module touching `navigator.clipboard` fails to compile.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client", "jest", "@testing-library/jest-dom"]
  },
  "include": ["src", "jest.setup.ts"],
  "exclude": ["src/sw.ts"]
}
